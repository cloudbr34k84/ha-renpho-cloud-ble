{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Renpho",
        "menu_options": {
          "cloud": "Renpho Health account (cloud)",
          "pick_scale": "Bluetooth scale (local)"
        }
      },
      "cloud": {
        "title": "Renpho Health account",
        "data": {
          "email": "Email",
          "password": "Password"
        },
        "description": "Polls your Renpho Health account for each person's latest measurement. Accounts created before 2024 may need migrating to the Renpho Health app first. Very short polling intervals can hit Renpho's API rate limits."
      },
      "reauth_confirm": {
        "data": {
          "password": "Password"
        }
      },
      "bluetooth_confirm": {
        "description": "Set up {name}? Add a profile for each person afterwards."
      },
      "pick_scale": {
        "data": {
          "address": "Scale"
        }
      }
    },
    "error": {
      "invalid_auth": "Renpho rejected the login (Renpho code {detail}). Use the email and password of the Renpho Health app (blue icon). Accounts that sign in with Google or Apple have no Renpho password, so they can't be used here.",
      "cannot_connect": "Couldn't reach the Renpho cloud ({detail}). Check Home Assistant's internet access and try again in a minute."
    },
    "abort": {
      "already_configured": "Already configured",
      "no_devices_found": "No Renpho scale seen over Bluetooth \u2014 step on it to wake it, then retry",
      "not_supported": "Not a supported Renpho scale",
      "reauth_successful": "Re-authenticated"
    }
  },
  "config_subentries": {
    "profile": {
      "initiate_flow": {
        "user": "Add person"
      },
      "entry_type": "Person",
      "step": {
        "user": {
          "title": "Add person",
          "data": {
            "name": "Name",
            "sex": "Sex",
            "birthday": "Birthday",
            "height_cm": "Height",
            "start_weight": "Current weight",
            "tolerance": "Matching tolerance",
            "algorithm": "Body-fat algorithm",
            "athlete": "Athlete mode",
            "scale_profile_byte": "Scale profile byte (MorphoScan, optional)"
          },
          "data_description": {
            "start_weight": "Used to recognise this person until their first reading is stored.",
            "tolerance": "A reading within this many kg of the person's last weight is assigned to them.",
            "algorithm": "0x04 matches most Renpho scales; try 0x03 if body fat differs from the app.",
            "scale_profile_byte": "R-MSC04/R-MSC06 only: the 12th byte of the profile frame the Renpho app writes for this person, as two hex digits. With it, the scale's own body fat, visceral fat and skeletal muscle are used. Leave empty if unknown."
          }
        },
        "reconfigure": {
          "title": "Edit person",
          "data": {
            "name": "Name",
            "sex": "Sex",
            "birthday": "Birthday",
            "height_cm": "Height",
            "start_weight": "Current weight",
            "tolerance": "Matching tolerance",
            "algorithm": "Body-fat algorithm",
            "athlete": "Athlete mode",
            "scale_profile_byte": "Scale profile byte (MorphoScan, optional)"
          },
          "data_description": {
            "start_weight": "Used to recognise this person until their first reading is stored.",
            "tolerance": "A reading within this many kg of the person's last weight is assigned to them.",
            "algorithm": "0x04 matches most Renpho scales; try 0x03 if body fat differs from the app.",
            "scale_profile_byte": "R-MSC04/R-MSC06 only: the 12th byte of the profile frame the Renpho app writes for this person, as two hex digits. With it, the scale's own body fat, visceral fat and skeletal muscle are used. Leave empty if unknown."
          }
        }
      },
      "abort": {
        "reconfigure_successful": "Saved"
      },
      "error": {
        "name_exists": "A person with this name already uses this scale",
        "invalid_profile_byte": "Enter two hex digits, e.g. A9"
      }
