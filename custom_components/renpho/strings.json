  "options": {
    "step": {
      "init": {
        "data": {
          "scan_interval": "Polling interval",
          "allow_writes": "Send guest profile to scale",
          "capture_all_characteristics": "Capture all BLE characteristics (diagnostics)"
        },
        "data_description": {
          "allow_writes": "MorphoScan scales (R-MSC04/R-MSC06) need a guest profile and clock written on every connection, and extended 0x55aa scales need a guest profile (slot 9, never stored) before they release a final reading. Auto writes only where needed. Never = read-only, which MorphoScan scales answer by hanging up.",
          "capture_all_characteristics": "Logs every notification for protocol debugging. Download diagnostics to see it."
        }
      }
    }
  },
